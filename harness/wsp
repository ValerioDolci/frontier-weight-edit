#!/usr/bin/python3
"""wsp — your only tool.
  ./wsp py FILE.py      run FILE.py in the persistent CPU Python kernel over the weights
  ./wsp fwd FILE.json   one forward pass (counts against the budget)
  ./wsp status          budget used and current edits"""
import json, sys, urllib.request
if len(sys.argv) < 2 or sys.argv[1] not in ("py", "fwd", "status"): print(__doc__); sys.exit(1)
src = open(sys.argv[2]).read() if sys.argv[1] != "status" else ""
req = urllib.request.Request("http://127.0.0.1:18620/", data=json.dumps({"cmd": sys.argv[1], "src": src}).encode(), headers={"Content-Type": "application/json"})
print(urllib.request.urlopen(req, timeout=10800).read().decode(), end="")
